import {
    AboutSlint, Button, CheckBox, ComboBox, GroupBox, LineEdit, ScrollView,
    SpinBox, Switch, TextEdit, VerticalBox, HorizontalBox
} from "std-widgets.slint";

export struct PeerRow {
    device-id: string,
    title: string,
    subtitle: string,
    compatible: bool,
    trusted: bool,
}

export struct TrustedRow {
    device-id: string,
    title: string,
    subtitle: string,
}

component NavButton inherits Button {
    in property <bool> active;
    min-height: 38px;
}

export component AppWindow inherits Window {
    title: "Synly";
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 820px;
    min-height: 560px;
    background: #f5f6f4;
    icon: @image-url("tray-icon.svg");

    in-out property <int> selected-page: 0;
    in property <string> lifecycle-text: "空闲";
    in property <string> status-detail: "";
    in property <string> current-peer: "未连接";
    in property <bool> session-active: false;
    in property <bool> input-permission-ready: true;
    in property <string> desired-summary: "";
    in property <string> applied-summary: "";
    in property <string> pending-summary: "";
    in property <string> remote-summary: "";
    in property <string> epoch-summary: "";
    in property <[PeerRow]> peers;
    in property <[TrustedRow]> trusted-devices;
    in property <string> log-text;

    in-out property <int> connection-index: 0;
    in-out property <string> instance-name;
    in-out property <string> peer-query;
    in-out property <string> path-text;
    in-out property <string> port-text;
    in-out property <int> file-mode-index: 0;
    in-out property <int> initial-index: 0;
    in-out property <bool> sync-delete: false;
    in-out property <int> interval-secs: 3;
    in-out property <int> max-depth: -1;
    in-out property <int> clipboard-mode-index: 0;
    in-out property <int> audio-mode-index: 0;
    in-out property <int> input-mode-index: 0;
    in-out property <int> input-edge-index: 1;
    in-out property <string> input-hotkey: "ctrl+alt+shift+esc";
    in-out property <bool> accept-untrusted: false;
    in-out property <bool> trust-device: false;
    in-out property <bool> trusted-only: false;
    in-out property <string> fixed-pin;
    in-out property <string> device-name;
    in-out property <string> clipboard-max-file-text;
    in-out property <string> clipboard-max-cache-text;
    in-out property <string> clipboard-cache-dir;
    in-out property <string> transfer-meta-text;
    in-out property <string> transfer-frame-text;
    in-out property <string> transfer-clipboard-text;
    in-out property <bool> mdns-enabled: true;
    in-out property <bool> lnd-enabled: false;
    in-out property <string> lnd-server-url;
    in-out property <string> lnd-bearer-token;
    in-out property <string> lnd-discovery-domain;
    in-out property <bool> notifications-enabled: true;
    in-out property <bool> start-hidden: false;
    in-out property <bool> close-to-tray: true;
    in-out property <bool> launch-at-login: false;
    in-out property <bool> resume-last-session: false;
    in-out property <int> log-level-index: 2;

    in property <bool> interaction-visible: false;
    in property <string> interaction-title;
    in property <string> interaction-detail;
    in property <string> interaction-art;
    in property <string> interaction-pin;
    in property <int> interaction-kind: 0;
    in-out property <string> entered-pin;
    in-out property <bool> interaction-trust: false;

    callback start-hosting();
    callback connect-peer(string);
    callback connect-query();
    callback disconnect();
    callback apply-settings();
    callback choose-path();
    callback set-clipboard-mode(int);
    callback set-audio-mode(int);
    callback set-input-mode(int);
    callback request-input-elevation();
    callback revoke-trust(string);
    callback interaction-accept();
    callback interaction-reject();
    callback interaction-submit-pin();

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: 184px;
            background: #202523;

            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                Text {
                    text: "SYNLY";
                    color: #ffffff;
                    font-size: 22px;
                    font-weight: 700;
                    height: 44px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.lifecycle-text;
                    color: root.session-active ? #75d6a8 : #c6cbc8;
                    font-size: 12px;
                    height: 24px;
                }
                Rectangle { height: 8px; }
                NavButton { text: "状态"; active: root.selected-page == 0; clicked => { root.selected-page = 0; } }
                NavButton { text: "设备"; active: root.selected-page == 1; clicked => { root.selected-page = 1; } }
                NavButton { text: "同步"; active: root.selected-page == 2; clicked => { root.selected-page = 2; } }
                NavButton { text: "安全"; active: root.selected-page == 3; clicked => { root.selected-page = 3; } }
                NavButton { text: "设置"; active: root.selected-page == 4; clicked => { root.selected-page = 4; } }
                NavButton { text: "日志"; active: root.selected-page == 5; clicked => { root.selected-page = 5; } }
                NavButton { text: "About"; active: root.selected-page == 6; clicked => { root.selected-page = 6; } }
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: root.current-peer;
                    color: #c6cbc8;
                    wrap: word-wrap;
                    font-size: 11px;
                    height: 44px;
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: #f5f6f4;

            if root.selected-page == 0: VerticalLayout {
                padding: 24px;
                spacing: 16px;
                Text { text: "运行状态"; font-size: 24px; font-weight: 650; color: #202523; }
                GroupBox {
                    title: "当前会话";
                    VerticalLayout {
                        spacing: 10px;
                        Text { text: root.lifecycle-text; font-size: 20px; color: root.session-active ? #2e7d5b : #555b58; }
                        Text { text: root.status-detail; wrap: word-wrap; color: #555b58; }
                        Text { text: "对侧: " + root.current-peer; color: #343936; }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "开始监听"; enabled: !root.session-active; clicked => { root.start-hosting(); } }
                            Button { text: "连接设备"; enabled: !root.session-active; clicked => { root.selected-page = 1; } }
                            Button { text: "断开"; enabled: root.session-active; clicked => { root.disconnect(); } }
                        }
                    }
                }
                GroupBox {
                    title: "配置状态";
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: "期望: " + root.desired-summary; color: #343936; wrap: word-wrap; }
                        Text { text: "已应用: " + root.applied-summary; color: #343936; wrap: word-wrap; }
                        Text { text: "待应用: " + root.pending-summary; color: #8a4b2c; wrap: word-wrap; }
                        Text { text: "对侧: " + root.remote-summary; color: #555b58; wrap: word-wrap; }
                        Text { text: "Epoch: " + root.epoch-summary; color: #666c68; }
                    }
                }
                GroupBox {
                    title: "快捷开关";
                    HorizontalLayout {
                        spacing: 18px;
                        VerticalLayout {
                            Text { text: "剪贴板"; }
                            clipboard-box := ComboBox {
                                model: ["关闭", "发送", "接收", "双向"];
                                current-index <=> root.clipboard-mode-index;
                                selected(_) => { root.set-clipboard-mode(clipboard-box.current-index); }
                            }
                        }
                        VerticalLayout {
                            Text { text: "音频"; }
                            audio-box := ComboBox {
                                model: ["关闭", "发送", "接收"];
                                current-index <=> root.audio-mode-index;
                                selected(_) => { root.set-audio-mode(audio-box.current-index); }
                            }
                        }
                        VerticalLayout {
                            Text { text: "输入"; }
                            input-box := ComboBox {
                                model: ["关闭", "发送控制", "接受控制"];
                                current-index <=> root.input-mode-index;
                                selected(_) => { root.set-input-mode(input-box.current-index); }
                            }
                        }
                    }
                }
                if root.input-mode-index != 0 && !root.input-permission-ready: Rectangle {
                    height: 56px;
                    background: #fff2e8;
                    border-color: #e27a55;
                    border-width: 1px;
                    HorizontalLayout {
                        padding: 10px;
                        Text { text: "Windows 输入代理等待本机管理员授权"; vertical-alignment: center; color: #74351f; }
                        Button { text: "授权"; clicked => { root.request-input-elevation(); } }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }

            if root.selected-page == 1: VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text { text: "设备"; font-size: 24px; font-weight: 650; color: #202523; }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit { text <=> root.peer-query; placeholder-text: "设备名, ID 或地址"; horizontal-stretch: 1; }
                    Button { text: "直连"; clicked => { root.connect-query(); } }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 8px;
                        for peer in root.peers: Rectangle {
                            height: 78px;
                            background: #ffffff;
                            border-color: peer.compatible ? #d8dcda : #e27a55;
                            border-width: 1px;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding: 12px;
                                VerticalLayout {
                                    Text { text: peer.title; font-size: 15px; font-weight: 600; color: #202523; }
                                    Text { text: peer.subtitle; color: #666c68; font-size: 11px; wrap: word-wrap; }
                                }
                                Button {
                                    text: peer.trusted ? "可信连接" : "连接";
                                    enabled: peer.compatible && !root.session-active;
                                    clicked => { root.connect-peer(peer.device-id); }
                                }
                            }
                        }
                    }
                }
            }

            if root.selected-page == 2: ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;
                    Text { text: "同步设置"; font-size: 24px; font-weight: 650; color: #202523; }
                    GroupBox {
                        title: "文件";
                        VerticalLayout {
                            spacing: 8px;
                            ComboBox { model: ["关闭", "发送", "接收", "双向", "自动"]; current-index <=> root.file-mode-index; }
                            HorizontalLayout {
                                LineEdit { text <=> root.path-text; placeholder-text: "同步路径"; horizontal-stretch: 1; }
                                Button { text: "选择"; clicked => { root.choose-path(); } }
                            }
                            ComboBox { model: ["本机目录作为初始状态", "对端目录作为初始状态"]; current-index <=> root.initial-index; }
                            CheckBox { text: "同步删除"; checked <=> root.sync-delete; }
                            HorizontalLayout {
                                Text { text: "扫描间隔"; vertical-alignment: center; }
                                SpinBox { value <=> root.interval-secs; minimum: 1; maximum: 3600; }
                                Text { text: "秒"; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                Text { text: "最大目录深度"; vertical-alignment: center; }
                                SpinBox { value <=> root.max-depth; minimum: -1; maximum: 1024; }
                                Text { text: "-1 表示无限制"; vertical-alignment: center; color: #666c68; }
                            }
                        }
                    }
                    GroupBox {
                        title: "输入";
                        VerticalLayout {
                            ComboBox { model: ["关闭", "发送控制", "接受控制"]; current-index <=> root.input-mode-index; }
                            ComboBox { model: ["左侧", "右侧", "顶部", "底部"]; current-index <=> root.input-edge-index; }
                            LineEdit { text <=> root.input-hotkey; placeholder-text: "紧急收回热键"; }
                        }
                    }
                    Button { text: root.session-active ? "应用并按需重连" : "保存设置"; clicked => { root.apply-settings(); } }
                }
            }

            if root.selected-page == 3: VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text { text: "安全"; font-size: 24px; font-weight: 650; color: #202523; }
                HorizontalLayout {
                    CheckBox { text: "自动接受未信任设备"; checked <=> root.accept-untrusted; }
                    CheckBox { text: "配对后建立信任"; checked <=> root.trust-device; }
                    CheckBox { text: "仅允许可信设备"; checked <=> root.trusted-only; }
                }
                LineEdit {
                    text <=> root.fixed-pin;
                    placeholder-text: "本次进程使用的 6 位固定 PIN, 留空则随机生成";
                    input-type: password;
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 8px;
                        for device in root.trusted-devices: Rectangle {
                            height: 66px;
                            background: #ffffff;
                            border-color: #d8dcda;
                            border-width: 1px;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding: 10px;
                                VerticalLayout {
                                    Text { text: device.title; font-weight: 600; }
                                    Text { text: device.subtitle; color: #666c68; font-size: 11px; }
                                }
                                Button { text: "撤销信任"; clicked => { root.revoke-trust(device.device-id); } }
                            }
                        }
                    }
                }
                Button { text: "保存安全设置"; clicked => { root.apply-settings(); } }
            }

            if root.selected-page == 4: ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;
                    Text { text: "应用设置"; font-size: 24px; font-weight: 650; color: #202523; }
                    GroupBox {
                        title: "连接";
                        VerticalLayout {
                            ComboBox { model: ["监听连接", "连接设备"]; current-index <=> root.connection-index; }
                            LineEdit { text <=> root.instance-name; placeholder-text: "实例名"; }
                            LineEdit { text <=> root.peer-query; placeholder-text: "目标设备"; enabled: root.connection-index == 1; }
                            LineEdit { text <=> root.port-text; placeholder-text: "监听端口, 留空自动分配"; enabled: root.connection-index == 0; input-type: number; }
                        }
                    }
                    GroupBox {
                        title: "设备与发现";
                        VerticalLayout {
                            LineEdit { text <=> root.device-name; placeholder-text: "设备名"; }
                            CheckBox { text: "启用 mDNS 发现"; checked <=> root.mdns-enabled; }
                            CheckBox { text: "启用 LND 发现"; checked <=> root.lnd-enabled; }
                            LineEdit { text <=> root.lnd-server-url; placeholder-text: "LND 服务 URL"; enabled: root.lnd-enabled; }
                            LineEdit { text <=> root.lnd-bearer-token; placeholder-text: "LND bearer token"; input-type: password; enabled: root.lnd-enabled; }
                            LineEdit { text <=> root.lnd-discovery-domain; placeholder-text: "LND discovery domain, 可选"; enabled: root.lnd-enabled; }
                        }
                    }
                    GroupBox {
                        title: "剪贴板与传输限制";
                        VerticalLayout {
                            LineEdit { text <=> root.clipboard-max-file-text; placeholder-text: "剪贴板单文件上限, 字节"; input-type: number; }
                            LineEdit { text <=> root.clipboard-max-cache-text; placeholder-text: "剪贴板缓存上限, 字节, 留空不限制"; input-type: number; }
                            LineEdit { text <=> root.clipboard-cache-dir; placeholder-text: "剪贴板缓存目录, 可选"; }
                            LineEdit { text <=> root.transfer-meta-text; placeholder-text: "元数据上限, 字节"; input-type: number; }
                            LineEdit { text <=> root.transfer-frame-text; placeholder-text: "传输帧上限, 字节"; input-type: number; }
                            LineEdit { text <=> root.transfer-clipboard-text; placeholder-text: "剪贴板帧上限, 字节"; input-type: number; }
                        }
                    }
                    GroupBox {
                        title: "后台运行";
                        VerticalLayout {
                            CheckBox { text: "启用系统通知"; checked <=> root.notifications-enabled; }
                            CheckBox { text: "启动后隐藏到托盘"; checked <=> root.start-hidden; }
                            CheckBox { text: "关闭窗口时隐藏到托盘"; checked <=> root.close-to-tray; }
                            CheckBox { text: "登录时启动"; checked <=> root.launch-at-login; }
                            CheckBox { text: "启动后恢复上次会话"; checked <=> root.resume-last-session; }
                            HorizontalLayout {
                                Text { text: "日志级别"; vertical-alignment: center; }
                                ComboBox {
                                    model: ["Error", "Warn", "Info", "Debug", "Trace"];
                                    current-index <=> root.log-level-index;
                                }
                            }
                        }
                    }
                    Button { text: "保存设置"; clicked => { root.apply-settings(); } }
                }
            }

            if root.selected-page == 5: VerticalLayout {
                padding: 24px;
                spacing: 10px;
                Text { text: "日志"; font-size: 24px; font-weight: 650; color: #202523; }
                TextEdit {
                    text: root.log-text;
                    read-only: true;
                    vertical-stretch: 1;
                    font-family: "monospace";
                    font-size: 11px;
                }
            }

            if root.selected-page == 6: VerticalLayout {
                padding: 24px;
                spacing: 16px;
                Text { text: "Synly"; font-size: 26px; font-weight: 700; color: #202523; }
                Text { text: "安全的局域网同步与跨设备控制"; color: #555b58; }
                AboutSlint { height: 120px; }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }

    if root.interaction-visible: Rectangle {
        background: #00000088;
        Rectangle {
            width: min(parent.width - 40px, 620px);
            height: min(parent.height - 60px, 560px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #ffffff;
            border-radius: 6px;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text { text: root.interaction-title; font-size: 20px; font-weight: 650; color: #202523; }
                Text { text: root.interaction-detail; wrap: word-wrap; color: #555b58; }
                TextEdit { text: root.interaction-art; read-only: true; vertical-stretch: 1; font-family: "monospace"; font-size: 10px; }
                if root.interaction-pin != "": Text { text: "PIN: " + root.interaction-pin; font-size: 24px; font-weight: 700; color: #2e7d5b; horizontal-alignment: center; }
                if root.interaction-kind == 1: LineEdit { text <=> root.entered-pin; placeholder-text: "输入 6 位 PIN"; input-type: password; }
                if root.interaction-kind == 2: CheckBox { text: "建立长期信任"; checked <=> root.interaction-trust; }
                HorizontalLayout {
                    spacing: 8px;
                    if root.interaction-kind == 1: Button { text: "提交 PIN"; clicked => { root.interaction-submit-pin(); } }
                    if root.interaction-kind == 0 || root.interaction-kind == 1: Button { text: "取消配对"; clicked => { root.interaction-reject(); } }
                    if root.interaction-kind == 2 || root.interaction-kind == 3: Button { text: "接受"; clicked => { root.interaction-accept(); } }
                    if root.interaction-kind == 2 || root.interaction-kind == 3: Button { text: "拒绝"; clicked => { root.interaction-reject(); } }
                }
            }
        }
    }
}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("tray-icon.svg");
    in property <string> status-text: "Synly 空闲";
    in property <bool> connected: false;
    in property <bool> clipboard-enabled: false;
    in property <bool> audio-enabled: false;
    in property <bool> input-enabled: false;
    tooltip: status-text;

    callback open-window();
    callback connect-or-disconnect();
    callback toggle-clipboard();
    callback toggle-audio();
    callback toggle-input();
    callback quit();

    clicked => { root.open-window(); }

    Menu {
        MenuItem { title: "打开 Synly"; activated => { root.open-window(); } }
        MenuItem { title: root.status-text; enabled: false; }
        MenuSeparator { }
        MenuItem { title: root.connected ? "断开" : "开始"; activated => { root.connect-or-disconnect(); } }
        MenuItem { title: "剪贴板"; checkable: true; checked: root.clipboard-enabled; activated => { root.toggle-clipboard(); } }
        MenuItem { title: "音频"; checkable: true; checked: root.audio-enabled; activated => { root.toggle-audio(); } }
        MenuItem { title: "输入"; checkable: true; checked: root.input-enabled; activated => { root.toggle-input(); } }
        MenuSeparator { }
        MenuItem { title: "退出"; activated => { root.quit(); } }
    }
}
