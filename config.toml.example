# 每台设备的 UUID 和身份密钥由 identity.toml 保存.
# 首选活跃设备 ID, 由程序写入, host 重启后保持其活跃身份.
# preferred_active = "00000000-0000-0000-0000-000000000000"
[device]
device_name = "workstation"

[clipboard]
max_file_bytes = 104857600
max_cache_bytes = 536870912
# 可选. 相对路径基于 dirs::cache_dir()/synly.
# cache_dir = "clipboard-cache-custom"

[transfer]
max_meta_bytes = 20971520
max_frame_data_bytes = 134217728
max_clipboard_bytes = 104857600

[notifications]
enabled = true

[ui]
log_level = "info"
first_run_completed = false
start_hidden = false
close_to_tray = true
launch_at_login = false
resume_last_session = false
window_width = 1080
window_height = 720

[runtime]
connection = "host"
instance_name = ""
peer_query = ""
file_sync_mode = "off"
paths = []
sync_delete = false
clipboard_mode = "off"
audio_mode = "off"
interval_secs = 3
accept = false
trust_device = false
trusted_only = false

[input]
mode = "off"
edge = "right"
hotkey = "ctrl+alt+shift+esc"
elevate_on_start = false
reverse_mouse_wheel = false
reverse_trackpad = false
block_switch_on_press = false
# 光标模式三选一: desktop 固定桌面光标, auto 按前台光标捕获状态自动切换, game 固定游戏光标(相对增量注入).
cursor_mode = "auto"
# 映射由发送端应用, 仅在 macOS 与 Windows 之间生效. 清空两张表即可禁用映射;
# 多个来源键可以映射到同一个目标键, 同时按下时后按的键会被忽略.
[input.key_mapping.macos_to_windows]
left_option = "left_win"
right_option = "right_win"
left_command = "left_alt"
right_command = "right_alt"

[input.key_mapping.windows_to_macos]
left_win = "left_option"
right_win = "right_option"
left_alt = "left_command"
right_alt = "right_command"

[discovery]
mdns_enabled = true

# 可选. 取消以下注释以启用 LND 聚合发现.
# server_url 是服务根 URL, 不包含 /v1.
# [discovery.lnd]
# server_url = "http://127.0.0.1:8765"
# bearer_token = "replace-me"
# discovery_domain = "office-a"
